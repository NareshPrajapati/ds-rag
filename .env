# ---- Data / storage paths ----
RAG_DATA_DIR=data
RAG_CHROMA_DIR=artifacts/chroma
RAG_EMBEDDING_CACHE_DIR=artifacts/embeddings
RAG_COLLECTION_NAME=financial_reports_v1

# ---- Models ----
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_OPENAI_MODEL=gpt-4.1-mini

# ---- Chunking ----
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# ---- Retrieval ----
RAG_SEMANTIC_TOP_K=12
RAG_KEYWORD_TOP_K=12
RAG_FINAL_TOP_K=6

# ---- LLM generation (optional). Leave unset to use the offline extractive fallback. ----
# OPENAI_API_KEY=sk-...
